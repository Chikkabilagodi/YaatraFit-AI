# GEMINI_API_KEY: Required for server-side Gemini AI API calls (/api/ai/*).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Browser key for Google Maps JS API, Places API (New), and Routes API.
# Restrict by HTTP referrer and permitted APIs in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
